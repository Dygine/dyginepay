# ---------------------------------------------------------------- required --
DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require
BASE_URL=https://pay.dygine.com
ENVIRONMENT=production
DEBUG=false
SESSION_COOKIE_SECURE=true

# Generate real values:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production if these are left as defaults.
SECRET_KEY=
ENCRYPTION_KEY=
INTERNAL_TASK_TOKEN=

# ------------------------------------------------------------------- admin --
ADMIN_EMAIL=you@dygine.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------- razorpay --
# Test keys work with no KYC. Swap to live after activation.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# From Razorpay dashboard → Settings → Webhooks. Different from the key secret.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# ------------------------------------------- business identity on invoices --
BUSINESS_NAME=Dygine Software Solution
BUSINESS_ADDRESS=Bengaluru, Karnataka, India
BUSINESS_EMAIL=billing@dygine.com
BUSINESS_PHONE=
BUSINESS_STATE_CODE=29

# Leave EMPTY until you are GST registered.
#   empty  -> bills of supply, no tax charged (correct below 20 lakh services)
#   filled -> tax invoices with CGST/SGST or IGST, decided by customer state
# Nothing else changes when you set it.
BUSINESS_GSTIN=
BUSINESS_PAN=
DEFAULT_GST_RATE=18
DEFAULT_SAC=997331
INVOICE_PREFIX=DGN

# ----------------------------------------------------------------- workers --
DISPATCHER_ENABLED=true
DISPATCHER_INTERVAL_SECONDS=10
